# --- secrets ---
.env
.env.*
!.env.example
secrets/
credentials/
*.key
*.pem

# --- private / real data (client transcripts, CRM exports, PII) ---
data/raw/
data/interim/
data/processed/private/
*.csv
*.parquet
*.xlsx
!tests/fixtures/**/*.csv
!evals/datasets/**/*.csv

# --- pre-existing local docs (business/partner docs, never committed) ---
# Deliberately broad: it hides private local notes/proposals kept at the repo root. Side effect: a
# NEW root-level .md/.html is ignored too — add an explicit `!name` exception below when one should
# be versioned (e.g. README/AGENTS/CLAUDE). Project docs belong in docs/, which is not affected.
/*.md
/*.html
!README.md
!AGENTS.md
!CLAUDE.md

# --- python ---
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# --- editor / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- claude code runtime (session-local, not team config) ---
.claude/scheduled_tasks.lock
.claude/worktrees/
!.claude/agents/
!.claude/agents/**

# --- experiment artifacts (local runs; regenerate, never commit) ---
artifacts/
