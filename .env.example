# Copy to .env and fill in. Never commit .env.
# This file lists variable NAMES only — no real values, no real keys.

# LLM provider
# The only implemented provider is local Ollama (src/closer_ai/ai/ollama_provider.py), configured
# explicitly in code (model, base_url on loopback, timeout, num_ctx) — it needs NO secret and reads
# nothing from the environment. A cloud LLM provider is not implemented; adding one requires an
# explicit privacy/authorization decision first (docs/decisions/ADR_004, ADR_005).

# CRM integrations (Kommo / Pipedrive) — placeholders, not wired up yet
CRM_API_KEY=
CRM_API_BASE_URL=

# App
ENV=development
LOG_LEVEL=info
